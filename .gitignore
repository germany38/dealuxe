node_modules/

# Local Netlify folder
.netlify

# Generated by scripts/build-cloudflare-pages.mjs during the Cloudflare build
.cloudflare-pages/

# Python bytecode caches (keep pull requests small)
__pycache__/
*.pyc

# Legacy duplicate slug list; data/products.txt is the single source of truth
/products.txt

# A previous run copied the whole site into .github/, which doubled the repo and
# stalled GitHub pushes. Only .github/workflows belongs here.
.github/*
!.github/workflows/
